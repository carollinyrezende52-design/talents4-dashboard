<body>
<aside class="sidebar">
  <div class="brand"><div class="brand-mark">T4</div><div class="brand-copy"><div class="brand-title">Talents 4</div><div class="brand-sub">German Academy</div></div></div>
  <div class="nav-section">
    <div class="nav-label">Curso de Alemão</div>
    <button type="button" class="nav-item active" data-view="overview"><span class="nav-icon">📊</span><span>Visão geral</span></button>
    <button type="button" class="nav-item" data-view="classes"><span class="nav-icon">🏫</span><span>Turmas</span><span class="nav-count" id="nav-classes">0</span></button>
    <button type="button" class="nav-item" data-view="students"><span class="nav-icon">👥</span><span>Alunos</span><span class="nav-count" id="nav-students">0</span></button>
    <button type="button" class="nav-item" data-view="history"><span class="nav-icon">📝</span><span>Acompanhamentos</span></button>
  </div>
  <div class="sidebar-bottom">
    <a class="switch-link" href="index.html"><span class="nav-icon">↗</span><span>CRM Institucional</span></a>
    <a class="switch-link" href="organizacional.html"><span class="nav-icon">↗</span><span>Organizacional</span></a>
    <div class="user-card"><div class="avatar" id="user-avatar">?</div><div><div class="user-name" id="user-name">—</div><div class="user-role" id="user-role">—</div></div></div>
  </div>
</aside>

<main class="main">
  <header class="topbar">
    <div><div class="top-title" id="top-title">Curso de Alemão</div><div class="top-sub" id="top-sub">Turmas, evolução e prontidão dos talentos</div></div>
    <div class="top-spacer"></div>
    <div class="sync"><span class="sync-dot loading" id="sync-dot"></span><span id="sync-label">carregando...</span></div>
    <button type="button" class="btn sm" id="refresh-btn">↻ Atualizar</button>
  </header>
  <div class="content">
    <div class="setup" id="setup-banner"><h3>Banco do módulo ainda não preparado</h3><p id="setup-message">Execute a migration <code>supabase/migrations/202608130001_german_course_module.sql</code> no projeto Supabase e atualize esta página.</p></div>
    <section id="view-root"></section>
  </div>
</main>

<div class="modal-overlay" id="class-modal">
  <div class="modal">
    <div class="modal-head"><div class="modal-title" id="class-modal-title">Nova turma</div><button type="button" class="modal-close" data-close="class-modal">×</button></div>
    <form id="class-form">
      <div class="modal-body"><input type="hidden" id="class-id"><div class="form-grid">
        <div class="field"><label>Código *</label><input type="text" id="class-code" placeholder="T1" required></div>
        <div class="field"><label>Nome da turma *</label><input type="text" id="class-name" placeholder="Turma T1 — B1" required></div>
        <div class="field"><label>Escola / fornecedor</label><input type="text" id="class-provider" placeholder="Instituição de ensino"></div>
        <div class="field"><label>Professor(a)</label><input type="text" id="class-teacher" placeholder="Nome do responsável pedagógico"></div>
        <div class="field"><label>Nível inicial</label><select id="class-level-start"></select></div>
        <div class="field"><label>Meta da turma</label><select id="class-level-target"></select></div>
        <div class="field"><label>Data de início</label><input type="date" id="class-start"></div>
        <div class="field"><label>Previsão de término</label><input type="date" id="class-end"></div>
        <div class="field"><label>Modalidade</label><select id="class-modality"><option>Online</option><option>Presencial</option><option>Híbrido</option></select></div>
        <div class="field"><label>Capacidade</label><input type="number" min="1" max="500" id="class-capacity" value="20"></div>
        <div class="field"><label>Status</label><select id="class-status"><option>Planejada</option><option>Ativa</option><option>Pausada</option><option>Concluída</option><option>Cancelada</option></select></div>
        <div class="field"><label>Dias e horários</label><input type="text" id="class-schedule" placeholder="Seg/Qua, 19h–21h"></div>
        <div class="field"><label>Link da aula</label><input type="url" id="class-meeting" placeholder="https://..."></div>
        <div class="field"><label>Pasta / Drive</label><input type="url" id="class-drive" placeholder="https://drive.google.com/..."></div>
        <div class="field full"><label>Observações</label><textarea id="class-notes" placeholder="Contexto da turma, acordos com escola, material e observações operacionais."></textarea></div>
      </div></div>
      <div class="modal-footer"><button type="button" class="btn" data-close="class-modal">Cancelar</button><button type="submit" class="btn primary">Salvar turma</button></div>
    </form>
  </div>
</div>

<div class="modal-overlay" id="enrollment-modal">
  <div class="modal">
    <div class="modal-head"><div class="modal-title" id="enrollment-modal-title">Matricular aluno</div><button type="button" class="modal-close" data-close="enrollment-modal">×</button></div>
    <form id="enrollment-form">
      <div class="modal-body"><input type="hidden" id="enrollment-id"><div class="form-grid">
        <div class="form-section">Vínculo com a turma</div>
        <div class="field"><label>Candidato *</label><select id="enrollment-candidate" required></select></div>
        <div class="field"><label>Turma *</label><select id="enrollment-class" required></select></div>
        <div class="field"><label>Status</label><select id="enrollment-status"><option>Matriculado</option><option>Ativo</option><option>Pausado</option><option>Concluído</option><option>Desistente</option><option>Transferido</option></select></div>
        <div class="field"><label>Data da matrícula</label><input type="date" id="enrollment-date"></div>
        <div class="form-section">Evolução e prontidão</div>
        <div class="field"><label>Nível atual</label><select id="enrollment-level"></select></div>
