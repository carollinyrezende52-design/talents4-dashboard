.switch-link:hover{border-color:#b9c9da;color:var(--text);background:var(--surface-2)}
.user-card{display:flex;align-items:center;gap:9px;margin-top:12px;padding:9px;background:#fff;border:1px solid var(--line);border-radius:10px}
.avatar{width:32px;height:32px;border-radius:50%;background:#2dd4bf;color:#fff;display:grid;place-items:center;font-weight:800}.user-name{font-size:12px;font-weight:750}.user-role{font-size:10px;color:var(--muted-2);margin-top:1px}
.main{margin-left:248px;width:calc(100% - 248px);min-height:100vh}
