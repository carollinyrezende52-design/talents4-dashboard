.brand-title{font-size:16px;font-weight:800}.brand-sub{font-size:10px;color:var(--muted-2);text-transform:uppercase;letter-spacing:.08em;margin-top:2px}
.nav-section{padding:18px 12px 4px}.nav-label{padding:0 8px 8px;font-size:10px;text-transform:uppercase;letter-spacing:.09em;color:var(--muted-2);font-weight:800}
.nav-item{width:100%;border:0;background:transparent;color:#4a607a;display:flex;align-items:center;gap:10px;padding:10px 12px;border-radius:9px;text-align:left;font-weight:650;margin-bottom:3px}
