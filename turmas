.grid-2{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(320px,.75fr);gap:16px}.panel{background:#fff;border:1px solid var(--line);border-radius:var(--radius);box-shadow:0 5px 18px rgba(15,23,42,.04);overflow:hidden}.panel-head{padding:15px 17px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}.panel-title{font-size:13px;font-weight:800}.panel-sub{font-size:10.5px;color:var(--muted);margin-top:2px}.panel-spacer{flex:1}.panel-body{padding:16px}
.toolbar{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:14px}.search{min-width:260px;flex:1;position:relative}.search input{width:100%;padding:9px 11px 9px 34px;border:1px solid var(--line);background:#fff;border-radius:9px;outline:none}.search:before{content:'⌕';position:absolute;left:12px;top:7px;color:var(--muted-2);font-size:16px}.control{padding:9px 10px;border:1px solid var(--line);background:#fff;color:var(--text);border-radius:9px;outline:none;min-width:150px}.control:focus,.search input:focus{border-color:#8eb4ec;box-shadow:0 0 0 3px rgba(37,99,235,.08)}
.class-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.class-card{border:1px solid var(--line);border-radius:12px;padding:15px;background:linear-gradient(180deg,#fff,#fbfdff);cursor:pointer;transition:.15s}.class-card:hover{transform:translateY(-1px);border-color:#b8cce2;box-shadow:0 8px 22px rgba(15,23,42,.07)}.class-top{display:flex;align-items:flex-start;gap:10px}.class-code{width:44px;height:44px;border-radius:11px;background:var(--blue-soft);color:var(--blue-2);display:grid;place-items:center;font-weight:850;font-family:'IBM Plex Mono',monospace}.class-name{font-size:13px;font-weight:800}.class-meta{font-size:10.5px;color:var(--muted);margin-top:3px;line-height:1.4}.badge{display:inline-flex;align-items:center;padding:3px 8px;border-radius:999px;font-size:9.5px;font-weight:800;border:1px solid var(--line);background:#f4f7fa;color:var(--muted);white-space:nowrap}.badge.green{background:var(--green-soft);color:var(--green);border-color:#c9ead4}.badge.amber{background:var(--amber-soft);color:var(--amber);border-color:#f1dfb5}.badge.red{background:var(--red-soft);color:var(--red);border-color:#f2cccc}.badge.blue{background:var(--blue-soft);color:var(--blue-2);border-color:#cbdcfa}.badge.purple{background:#f3edff;color:var(--purple);border-color:#ded0fb}.class-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:7px;margin-top:13px}.mini{background:#f6f9fc;border:1px solid #e7edf4;border-radius:8px;padding:8px}.mini-label{font-size:9px;color:var(--muted-2);text-transform:uppercase;font-weight:800}.mini-value{font-size:12px;font-weight:800;margin-top:3px}.progress{height:7px;background:#e9eef5;border-radius:999px;overflow:hidden}.progress>span{display:block;height:100%;background:linear-gradient(90deg,#2563eb,#60a5fa);border-radius:inherit}.class-progress{margin-top:12px}.progress-line{display:flex;justify-content:space-between;font-size:9.5px;color:var(--muted);margin-bottom:5px}
.priority-list{display:flex;flex-direction:column;gap:9px}.priority-item{border:1px solid var(--line);border-left:4px solid var(--amber);border-radius:10px;padding:10px 11px;background:#fff;cursor:pointer}.priority-item.high{border-left-color:var(--red);background:#fffafa}.priority-name{font-size:11.5px;font-weight:800}.priority-meta{font-size:10px;color:var(--muted);margin-top:3px;line-height:1.45}.empty{padding:35px 18px;text-align:center;color:var(--muted-2);border:1px dashed var(--line-2);border-radius:12px;background:#fbfdff}.empty strong{display:block;color:var(--muted);margin-bottom:5px}.empty small{line-height:1.55}
.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:12px;background:#fff}.data-table{width:100%;border-collapse:collapse;min-width:1050px}.data-table th{position:sticky;top:0;background:#f7faff;color:var(--muted-2);font-size:9.5px;text-transform:uppercase;letter-spacing:.07em;text-align:left;padding:10px 11px;border-bottom:1px solid var(--line);z-index:1}.data-table td{padding:10px 11px;border-bottom:1px solid #edf1f5;vertical-align:middle;font-size:11px}.data-table tr:last-child td{border-bottom:0}.data-table tbody tr:hover{background:#f9fbfe}.student-name{font-size:11.5px;font-weight:800}.student-sub{font-size:9.5px;color:var(--muted-2);margin-top:2px}.cell-actions{display:flex;gap:5px;justify-content:flex-end}.pct{display:flex;align-items:center;gap:7px}.pct .progress{width:70px;height:6px}.attendance-low{color:var(--red);font-weight:800}.attendance-ok{color:var(--green);font-weight:800}
