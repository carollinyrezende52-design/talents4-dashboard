}

function filteredUpdates(){
  const q=state.filters.q.toLowerCase();return state.updates.filter(u=>{const e=byId(state.enrollments,u.enrollment_id)||{},c=candidateFor(e),cl=classFor(e);return (!state.filters.classId||e.class_id===state.filters.classId)&&(!state.filters.kind||u.kind===state.filters.kind)&&(!q||[c.nome_completo,cl.code,u.note,u.kind,u.attendance_status,u.level_after].join(' ').toLowerCase().includes(q));});
}
function renderHistory(){
  const list=filteredUpdates();const actions=canEdit()?`<button class="btn hero-btn" data-action="new-update">+ Novo acompanhamento</button>`:'';
  return `${hero(actions)}<div class="toolbar"><div class="search"><input id="filter-q" value="${attr(state.filters.q)}" placeholder="Buscar aluno ou conteúdo do registro..."></div><select class="control" id="filter-class"><option value="">Todas as turmas</option>${state.classes.map(c=>`<option value="${attr(c.id)}" ${state.filters.classId===c.id?'selected':''}>${esc(c.code)} · ${esc(c.name)}</option>`).join('')}</select><select class="control" id="filter-kind"><option value="">Todos os tipos</option>${['Presença','Avaliação','Evolução','Contato','Alerta'].map(x=>`<option ${state.filters.kind===x?'selected':''}>${x}</option>`).join('')}</select></div><div class="history-list">${list.length?list.map(u=>{const e=byId(state.enrollments,u.enrollment_id)||{},c=candidateFor(e),cl=classFor(e);const extra=[u.attendance_status,u.score!=null?`Nota ${u.score}`:'',u.level_after?`Nível ${u.level_after}`:''].filter(Boolean).join(' · ');return `<article class="history-item"><div class="history-date">${datePt(u.event_date)}</div><div class="history-kind">${badge(u.kind)}</div><div><div class="history-name">${esc(text(c.nome_completo,'Candidato'))}</div><div class="student-sub">${esc(text(cl.code,'Sem turma'))} · ${esc(text(cl.name,''))}</div></div><div class="history-note">${esc(text(u.note,'Sem observação.'))}${extra?`<div class="history-extra">${esc(extra)}</div>`:''}</div></article>`}).join(''):`<div class="empty"><strong>Nenhum acompanhamento registrado</strong><small>Registre presença, avaliação, evolução, contato ou alerta.</small></div>`}</div>`;
}

function bindViewInputs(){
  const q=document.getElementById('filter-q');if(q)q.oninput=()=>{state.filters.q=q.value;render()};
  const map={
    'filter-status':'status','filter-class':'classId','filter-risk':'risk','filter-kind':'kind'
  };
  Object.entries(map).forEach(([id,key])=>{const el=document.getElementById(id);if(el)el.onchange=()=>{state.filters[key]=el.value;render()}});
}
function resetFilters(){state.filters={q:'',classId:'',status:'',risk:'',kind:'',special:''};}

function fillEnrollmentSelects(){
  const classSel=document.getElementById('enrollment-class');classSel.innerHTML='<option value="">— selecionar turma —</option>'+state.classes.map(c=>`<option value="${attr(c.id)}" ${['Concluída','Cancelada'].includes(c.status)?'disabled':''}>${esc(c.code)} · ${esc(c.name)}${['Concluída','Cancelada'].includes(c.status)?` (${esc(c.status)})`:''}</option>`).join('');
  const candidateSel=document.getElementById('enrollment-candidate');candidateSel.innerHTML='<option value="">— selecionar candidato —</option>'+state.candidates.filter(c=>String(c.ativo||'SIM').toUpperCase()!=='NÃO').map(c=>`<option value="${attr(c.id)}">${esc(c.nome_completo)} · ${esc(text(c.nivel_alemao||c.nivel_alemao_declarado,'sem nível'))}</option>`).join('');
}
function fillUpdateEnrollments(){
  const el=document.getElementById('update-enrollment');el.innerHTML='<option value="">— selecionar aluno —</option>'+state.enrollments.filter(e=>ACTIVE_ENROLLMENTS.includes(e.status)).map(e=>{const c=candidateFor(e),cl=classFor(e);return `<option value="${attr(e.id)}">${esc(text(c.nome_completo,'Candidato'))} · ${esc(text(cl.code,'Sem turma'))}</option>`}).join('');
}

function openClass(id=''){
  if(!canEdit())return;const item=id?byId(state.classes,id):null;document.getElementById('class-modal-title').textContent=item?'Editar turma':'Nova turma';document.getElementById('class-form').reset();document.getElementById('class-id').value=item?.id||'';
  document.getElementById('class-code').value=item?.code||nextClassCode();document.getElementById('class-name').value=item?.name||'';document.getElementById('class-provider').value=item?.provider||'';document.getElementById('class-teacher').value=item?.teacher_name||'';document.getElementById('class-level-start').value=item?.level_start||'A1';document.getElementById('class-level-target').value=item?.level_target||'B1';document.getElementById('class-start').value=item?.start_date||'';document.getElementById('class-end').value=item?.expected_end_date||'';document.getElementById('class-modality').value=item?.modality||'Online';document.getElementById('class-capacity').value=item?.capacity||20;document.getElementById('class-status').value=item?.status||'Planejada';document.getElementById('class-schedule').value=item?.schedule_text||'';document.getElementById('class-meeting').value=item?.meeting_link||'';document.getElementById('class-drive').value=item?.drive_link||'';document.getElementById('class-notes').value=item?.notes||'';modal('class-modal');
}
function nextClassCode(){const nums=state.classes.map(c=>Number(String(c.code||'').match(/^T(\d+)$/i)?.[1]||0));return `T${Math.max(0,...nums)+1}`;}
function openEnrollment(id='',preferredClass=''){
  if(!canEdit())return;fillEnrollmentSelects();const item=id?byId(state.enrollments,id):null,candidate=item?candidateFor(item):{};document.getElementById('enrollment-modal-title').textContent=item?'Editar acompanhamento do aluno':'Matricular aluno';document.getElementById('enrollment-form').reset();document.getElementById('enrollment-id').value=item?.id||'';document.getElementById('enrollment-candidate').value=item?.candidate_id||'';document.getElementById('enrollment-class').value=item?.class_id||preferredClass||state.selectedClassId||'';document.getElementById('enrollment-candidate').disabled=!!item;document.getElementById('enrollment-class').disabled=!!item;document.getElementById('enrollment-status').value=item?.status||'Matriculado';document.getElementById('enrollment-date').value=item?.enrolled_at||today();document.getElementById('enrollment-level').value=item?.current_level||candidate.nivel_alemao||candidate.nivel_alemao_declarado||'';document.getElementById('enrollment-target').value=item?.target_level||candidate.nivel_alvo||classFor(item||{class_id:preferredClass}).level_target||'B1';document.getElementById('enrollment-progress').value=item?.progress_percent||0;document.getElementById('enrollment-performance').value=item?.performance||'Sem avaliação';document.getElementById('enrollment-risk').value=item?.risk_level||'Baixo';document.getElementById('enrollment-exam').value=item?.exam_status||'Não agendado';document.getElementById('enrollment-next').value=item?.next_action||'';document.getElementById('enrollment-due').value=item?.next_action_due||'';document.getElementById('enrollment-owner').value=item?.owner_name||candidate.responsavel_interno||'';document.getElementById('enrollment-notes').value=item?.notes||'';modal('enrollment-modal');
}
function openUpdate(enrollmentId=''){
  if(!canEdit())return;fillUpdateEnrollments();document.getElementById('update-form').reset();document.getElementById('update-date').value=today();document.getElementById('update-enrollment').value=enrollmentId||'';document.getElementById('update-kind').value='Presença';document.getElementById('update-level').value='';toggleUpdateFields();modal('update-modal');
}
function toggleUpdateFields(){const kind=document.getElementById('update-kind').value;document.getElementById('attendance-field').classList.toggle('show',kind==='Presença');document.getElementById('score-field').classList.toggle('show',kind==='Avaliação');}

async function saveClass(event){
  event.preventDefault();if(!canEdit())return;const id=document.getElementById('class-id').value;const row={code:document.getElementById('class-code').value.trim().toUpperCase(),name:document.getElementById('class-name').value.trim(),provider:document.getElementById('class-provider').value.trim()||null,teacher_name:document.getElementById('class-teacher').value.trim()||null,level_start:document.getElementById('class-level-start').value,level_target:document.getElementById('class-level-target').value,start_date:document.getElementById('class-start').value||null,expected_end_date:document.getElementById('class-end').value||null,modality:document.getElementById('class-modality').value,capacity:Number(document.getElementById('class-capacity').value||20),status:document.getElementById('class-status').value,schedule_text:document.getElementById('class-schedule').value.trim()||null,meeting_link:document.getElementById('class-meeting').value.trim()||null,drive_link:document.getElementById('class-drive').value.trim()||null,notes:document.getElementById('class-notes').value.trim()||null};
  try{setSync('loading','salvando...');const resp=id?await supa.from('german_course_classes').update(row).eq('id',id):await supa.from('german_course_classes').insert(row);if(resp.error)throw resp.error;modal('class-modal',false);await loadData();toast(id?'Turma atualizada.':'Turma criada.');}catch(error){setSync('error','erro ao salvar');toast(error.message||String(error),'error');}
}
async function syncCandidateSnapshot(enrollment){
  const courseClass=byId(state.classes,enrollment.class_id)||{};const active=ACTIVE_ENROLLMENTS.includes(enrollment.status);const fields={em_curso_de_alemao:active?'SIM':'NÃO',nivel_alemao:enrollment.current_level||null,nivel_alvo:enrollment.target_level||courseClass.level_target||null,instituicao_ensino:courseClass.provider||null,data_inicio_curso_alemao:enrollment.enrolled_at||null,previsao_termino_alemao:courseClass.expected_end_date||null,horario_dias_aula:courseClass.schedule_text||null,ultima_atualizacao:new Date().toISOString()};
  ['nivel_alemao','nivel_alvo','instituicao_ensino','data_inicio_curso_alemao','previsao_termino_alemao','horario_dias_aula'].forEach(key=>{if(fields[key]===null)delete fields[key]});
  const resp=await supa.from('candidatos').update(fields).eq('id',enrollment.candidate_id);if(resp.error)throw resp.error;
}
async function saveEnrollment(event){
  event.preventDefault();if(!canEdit())return;const id=document.getElementById('enrollment-id').value;const status=document.getElementById('enrollment-status').value;const row={candidate_id:document.getElementById('enrollment-candidate').value,class_id:document.getElementById('enrollment-class').value,status,completed_at:status==='Concluído'?today():null,enrolled_at:document.getElementById('enrollment-date').value||today(),current_level:document.getElementById('enrollment-level').value||null,target_level:document.getElementById('enrollment-target').value||null,progress_percent:clamp(document.getElementById('enrollment-progress').value),performance:document.getElementById('enrollment-performance').value,risk_level:document.getElementById('enrollment-risk').value,exam_status:document.getElementById('enrollment-exam').value,next_action:document.getElementById('enrollment-next').value.trim()||null,next_action_due:document.getElementById('enrollment-due').value||null,owner_name:document.getElementById('enrollment-owner').value.trim()||null,notes:document.getElementById('enrollment-notes').value.trim()||null};
  if(id){delete row.candidate_id;delete row.class_id;}
  try{setSync('loading','salvando...');let saved;if(id){const resp=await supa.from('german_course_enrollments').update(row).eq('id',id).select('*').single();if(resp.error)throw resp.error;saved=resp.data;}else{const resp=await supa.from('german_course_enrollments').insert(row).select('*').single();if(resp.error)throw resp.error;saved=resp.data;}
    let syncWarning='';try{await syncCandidateSnapshot(saved)}catch(error){console.warn('[Curso Alemão] snapshot candidato',error);syncWarning=' O vínculo foi salvo, mas o resumo no cadastro do candidato não sincronizou.'}
    modal('enrollment-modal',false);await loadData();toast((id?'Matrícula atualizada.':'Aluno matriculado.')+syncWarning,syncWarning?'warn':'');
  }catch(error){setSync('error','erro ao salvar');toast(error.message||String(error),'error');}
  finally{document.getElementById('enrollment-candidate').disabled=false;document.getElementById('enrollment-class').disabled=false;}
}
async function saveUpdate(event){
  event.preventDefault();if(!canEdit())return;const kind=document.getElementById('update-kind').value;const row={enrollment_id:document.getElementById('update-enrollment').value,event_date:document.getElementById('update-date').value||today(),kind,attendance_status:kind==='Presença'?document.getElementById('update-attendance').value:null,score:kind==='Avaliação'&&document.getElementById('update-score').value!==''?Number(document.getElementById('update-score').value):null,level_after:document.getElementById('update-level').value||null,note:document.getElementById('update-note').value.trim()||null};
  try{setSync('loading','registrando...');const resp=await supa.from('german_course_updates').insert(row);if(resp.error)throw resp.error;modal('update-modal',false);await loadData();toast('Acompanhamento registrado.');}catch(error){setSync('error','erro ao registrar');toast(error.message||String(error),'error');}
}

function handleAction(target){
  const action=target.dataset.action,id=target.dataset.id;if(action==='new-class')openClass();else if(action==='open-class'){state.selectedClassId=id;if(canEdit())openClass(id);else{resetFilters();state.filters.classId=id;route('students')}}else if(action==='new-enrollment')openEnrollment('',state.selectedClassId);else if(action==='edit-enrollment')openEnrollment(id);else if(action==='new-update')openUpdate();else if(action==='new-update-for')openUpdate(id);else if(action==='clear-special'){state.filters.special='';render();}
}
function subscribeRealtime(){
  if(realtimeChannel)return;realtimeChannel=supa.channel('german-course-module').on('postgres_changes',{event:'*',schema:'public',table:'german_course_classes'},()=>scheduleRealtime()).on('postgres_changes',{event:'*',schema:'public',table:'german_course_enrollments'},()=>scheduleRealtime()).on('postgres_changes',{event:'*',schema:'public',table:'german_course_updates'},()=>scheduleRealtime()).subscribe();
}
function scheduleRealtime(){clearTimeout(scheduleRealtime.timer);scheduleRealtime.timer=setTimeout(()=>loadData(),350);}

document.addEventListener('click',event=>{
  const view=event.target.closest('[data-view]');if(view){event.preventDefault();resetFilters();route(view.dataset.view);return;}
  const action=event.target.closest('[data-action]');if(action){event.preventDefault();handleAction(action);return;}
  const close=event.target.closest('[data-close]');if(close){modal(close.dataset.close,false);}
});
document.querySelectorAll('.modal-overlay').forEach(el=>el.addEventListener('click',e=>{if(e.target===el)modal(el.id,false)}));
document.getElementById('class-form').addEventListener('submit',saveClass);
document.getElementById('enrollment-form').addEventListener('submit',saveEnrollment);
document.getElementById('update-form').addEventListener('submit',saveUpdate);
document.getElementById('update-kind').addEventListener('change',toggleUpdateFields);
document.getElementById('refresh-btn').addEventListener('click',()=>loadData({toast:true}));
document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('.modal-overlay.open').forEach(el=>modal(el.id,false))});

(async function init(){
  setLevelOptions();const session=await requireSession();if(!session)return;
  const params=new URLSearchParams(location.search);state.view=VIEW_META[params.get('view')]?params.get('view'):'overview';
  const filter=params.get('filter');if(['next_b1','next_b2','no_forecast'].includes(filter))state.filters.special=filter;else if(filter==='risk')state.filters.risk='Alto';
  route(state.view);await loadData();subscribeRealtime();
  supa.auth.onAuthStateChange(event=>{if(event==='SIGNED_OUT')location.replace('index.html')});
})();
</script>
</body>
</html>
