.hero:after{content:'DE';position:absolute;right:24px;top:-30px;font-size:150px;font-weight:900;opacity:.055;line-height:1}.hero-copy{max-width:760px;position:relative;z-index:1}.hero-kicker{font-size:10px;text-transform:uppercase;letter-spacing:.13em;color:#bfdbfe;font-weight:800;margin-bottom:7px}.hero h1{font-size:24px;line-height:1.25;margin-bottom:8px}.hero p{color:#d8e7fb;line-height:1.65;font-size:12px}.hero-actions{margin-left:auto;display:flex;gap:8px;position:relative;z-index:1;flex-wrap:wrap;justify-content:flex-end}
.btn{border:1px solid var(--line);background:#fff;color:var(--text);padding:9px 13px;border-radius:9px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:7px;white-space:nowrap}.btn:hover{background:var(--surface-2);border-color:var(--line-2)}.btn.primary{background:var(--blue);border-color:var(--blue);color:#fff;box-shadow:0 7px 18px rgba(37,99,235,.18)}.btn.primary:hover{background:var(--blue-2)}.btn.hero-btn{background:#fff;color:#17376b;border-color:#fff}.btn.ghost-light{background:rgba(255,255,255,.08);color:#fff;border-color:rgba(255,255,255,.28)}.btn.sm{padding:6px 9px;font-size:11px}.btn.icon{width:36px;height:36px;padding:0}.btn:disabled{opacity:.5;cursor:not-allowed}
