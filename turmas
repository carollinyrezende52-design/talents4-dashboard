.modal-overlay{position:fixed;inset:0;background:rgba(15,23,42,.42);display:none;align-items:center;justify-content:center;padding:22px;z-index:100}.modal-overlay.open{display:flex}.modal{width:min(760px,100%);max-height:92vh;background:#fff;border-radius:16px;box-shadow:0 24px 70px rgba(15,23,42,.25);overflow:auto}.modal.small{width:min(620px,100%)}.modal-head{position:sticky;top:0;background:#fff;z-index:2;padding:17px 20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:10px}.modal-title{font-size:15px;font-weight:850}.modal-close{margin-left:auto;border:0;background:transparent;color:var(--muted);font-size:20px;padding:3px 6px}.modal-body{padding:20px}.modal-footer{position:sticky;bottom:0;background:#fff;padding:13px 20px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:8px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.form-grid.three{grid-template-columns:repeat(3,1fr)}.field{display:flex;flex-direction:column;gap:5px}.field.full{grid-column:1/-1}.field label{font-size:9.5px;text-transform:uppercase;letter-spacing:.07em;color:var(--muted);font-weight:800}.field input,.field select,.field textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:9px 10px;background:#fff;color:var(--text);outline:none}.field textarea{min-height:76px;resize:vertical}.field input:focus,.field select:focus,.field textarea:focus{border-color:#8eb4ec;box-shadow:0 0 0 3px rgba(37,99,235,.08)}.field-help{font-size:9.5px;color:var(--muted-2);line-height:1.45}.form-section{font-size:11px;font-weight:850;padding-bottom:7px;border-bottom:1px solid var(--line);margin:5px 0 12px;grid-column:1/-1}.conditional{display:none}.conditional.show{display:flex}
.setup{display:none;padding:22px;border:1px solid #f0c4c4;background:#fff8f8;border-radius:14px;margin-bottom:16px}.setup.show{display:block}.setup h3{font-size:14px;color:var(--red);margin-bottom:7px}.setup p{font-size:11px;color:var(--muted);line-height:1.6}.setup code{font-family:'IBM Plex Mono',monospace;color:#7f1d1d}
.filter-note{display:flex;align-items:center;gap:8px;padding:9px 11px;background:var(--blue-soft);border:1px solid #cbdcfa;border-radius:10px;color:var(--blue-2);font-size:10.5px;font-weight:700;margin-bottom:12px}.filter-note button{margin-left:auto;border:0;background:transparent;color:var(--blue-2);font-weight:850}
.loading-screen{position:fixed;inset:0;background:var(--bg);display:flex;align-items:center;justify-content:center;z-index:200}.loader-card{background:#fff;border:1px solid var(--line);border-radius:14px;padding:24px 30px;text-align:center;box-shadow:var(--shadow)}.spinner{width:32px;height:32px;border:3px solid #dbe7f6;border-top-color:var(--blue);border-radius:50%;animation:spin .75s linear infinite;margin:0 auto 12px}@keyframes spin{to{transform:rotate(360deg)}}
.loader-sub{font-size:10px;color:var(--muted);margin-top:5px}
.toast{position:fixed;right:22px;bottom:22px;background:#142236;color:#fff;padding:11px 15px;border-radius:10px;box-shadow:var(--shadow);z-index:300;opacity:0;transform:translateY(8px);pointer-events:none;transition:.2s;max-width:420px;font-size:11px}.toast.show{opacity:1;transform:translateY(0)}.toast.error{background:#991b1b}.toast.warn{background:#92400e}
@media(max-width:1150px){.kpis{grid-template-columns:repeat(3,1fr)}.grid-2{grid-template-columns:1fr}.class-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:820px){.sidebar{width:72px}.brand{padding:17px 14px}.brand-copy,.nav-label,.nav-item span:not(.nav-icon):not(.nav-count),.switch-link span,.user-card>div:not(.avatar){display:none}.nav-item{justify-content:center;padding:11px 8px}.nav-count{position:absolute;margin:0;transform:translate(18px,-14px);min-width:18px;padding:1px 4px}.nav-item{position:relative}.switch-link{justify-content:center}.user-card{justify-content:center;padding:7px}.main{margin-left:72px;width:calc(100% - 72px)}.content{padding:18px}.topbar{padding:0 18px}.hero{display:block}.hero-actions{margin:16px 0 0;justify-content:flex-start}.kpis{grid-template-columns:repeat(2,1fr)}.class-grid{grid-template-columns:1fr}.form-grid,.form-grid.three{grid-template-columns:1fr}.history-item{grid-template-columns:1fr;gap:4px}}
