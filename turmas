.nav-icon{width:21px;text-align:center;font-size:15px}.nav-count{margin-left:auto;min-width:24px;padding:2px 7px;border:1px solid var(--line);border-radius:999px;text-align:center;font-size:10px;background:#fff;color:var(--muted)}
